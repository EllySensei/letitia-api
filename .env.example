DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=laetitia

PORT=3000

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Used once to create the first admin when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Folder of the frontend, served at http://localhost:3000 (relative to this project).
FRONTEND_DIR=../letitia-frontend

# Origin of the frontend if it is served from a different host/port instead,
# e.g. http://127.0.0.1:5500 for VS Code Live Server.
CORS_ORIGIN=
